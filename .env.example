# Copie para .env (fora do git) ou defina no provedor de deploy.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Origens do frontend permitidas (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:5173
# true quando atras de proxy (Render): usa X-Forwarded-For para o limite por IP
TRUST_PROXY=false
