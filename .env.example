# Copie para .env (fora do git) ou defina no provedor de deploy (Coolify).
# PostgreSQL com auth.users, public.admins e public.visits
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/postgres
# Texto longo e aleatorio que assina as sessoes. Ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Origens do frontend permitidas (separadas por virgula)
ALLOWED_ORIGINS=https://pv-bt-calc.vercel.app,http://localhost:5173
# true quando atras de proxy (Coolify/Traefik): usa X-Forwarded-For para o limite por IP
TRUST_PROXY=false
# false so para testar o cookie em http://localhost
COOKIE_SECURE=true
